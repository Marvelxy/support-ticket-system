DATABASE_URL="file:./dev.db"
JWT_SECRET="dev-secret-change-me"
PORT=4000
# AI provider: ollama | groq | gemini | rule (default: rule, zero-config)
AI_PROVIDER=rule
# Ollama (local, free) - works on 16GB Intel with llama3.2:3b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Groq (hosted free tier, no card) - get key at console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Gemini (hosted free tier, no card) - get key at aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
